# ==========================================
#  Center Domiciliation App - Variables d'environnement
#  Copie ce fichier en `.env` et adapte les valeurs.
#  `.env` est ignoré par git (voir .gitignore).
# ==========================================

# ----- Application -----
APP_NAME=Center Domiciliation App
APP_ENV=dev
APP_DEBUG=true
APP_URL=

# ----- Base de donnees (MySQL) -----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=center_domiciliation
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ----- IA (Anthropic Claude) -----
# Laisse vide pour desactiver les fonctionnalites IA
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_CACHE_TTL=3600
