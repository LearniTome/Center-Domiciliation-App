{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--no-usage-statistics"],
      "enabled": true
    },
    "mysql-dev": {
      "type": "local",
      "command": ["node", "scripts/mysql-mcp.mjs"],
      "enabled": true
    },
    "mysql-prod": {
      "type": "local",
      "command": ["npx", "-y", "@berthojoris/mcp-mysql-server", "mysql://user:pass@host:3306/center_domiciliation", "list,read"],
      "enabled": false
    }
  }
}
